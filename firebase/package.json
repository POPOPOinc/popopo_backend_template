{
  "name": "firebase",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "firebase emulators:exec --project=demo-template --only=firestore,storage,auth \"jest --runInBand\"",
    "lint": "eslint src/firestore.indexes.json",
    "dev": "firebase emulators:start --project=demo-template --only=firestore,auth,storage,ui --import ./emulator-data --export-on-exit ./emulator-data",
    "deploy": "firebase deploy --only storage,firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.2",
    "jest": "^30.5.2",
    "jsonc-eslint-parser": "^3.3.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
