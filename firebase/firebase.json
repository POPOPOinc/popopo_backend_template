{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/refs/heads/master/schema/firebase-config.json",
  "storage": {
    "rules": "src/storage.default.rules"
  },
  "firestore": {
    "rules": "src/firestore.rules",
    "indexes": "src/firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "host": "127.0.0.1",
      "port": 4000,
      "enabled": true
    },
    "singleProjectMode": true
  },
  "extensions": {
    "users": "firebase/firestore-bigquery-export@0.2.6",
    "posts": "firebase/firestore-bigquery-export@0.2.6"
  }
}
