{
  "compilerOptions": {
    "types": ["node", "jest"],
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "Preserve",
    "target": "ES2022",
    "lib": [ "ESNext", "esnext.disposable" ],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "types/**/*.d.ts", "jest.config.ts"]
}
