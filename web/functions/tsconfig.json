{
  "compilerOptions": {
    "module": "preserve",
    "noImplicitReturns": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["esnext", "DOM"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler"
  },
  "include": [
    "src"
  ]
}
