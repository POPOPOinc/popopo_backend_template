{
  "functions": {
    "source": "functions",
    "codebase": "web",
    "ignore": [
      "node_modules",
      ".cache",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "src/**"
    ]
  },
  "hosting": [
    {
      "site": "your-project-local-web",
      "public": "./dist/localhost",
      "ignore": [
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/.well-known/**",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "function": "renderHTML",
          "region": "asia-northeast1"
        }
      ]
    },
    {
      "site": "your-project-beta-web",
      "public": "./dist/beta",
