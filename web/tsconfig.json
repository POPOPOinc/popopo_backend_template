{
  "compilerOptions": {
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "target": "ES2022",
    "outDir": "build",
    "allowUnusedLabels": false,
    "alwaysStrict": true,
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "paths": {
            "~/*": ["./env/localhost/*"]
    },
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ESNext.Temporal"
    ],
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  }
}
