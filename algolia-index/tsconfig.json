{
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "Preserve",
    "esModuleInterop": true,
    "target": "ES2022",
    "lib": [ "ESNext", "esnext.disposable" ],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
  },
  "include": ["src/**/*.ts"]
}
