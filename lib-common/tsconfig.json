{
  "compilerOptions": {
    "types": ["node", "jest"],
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": [ "ESNext", "esnext.disposable" ],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
