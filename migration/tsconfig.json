{
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "paths": { "#*": ["./src/*"] },
    "moduleResolution": "Bundler",
    "module": "Preserve",
    "resolveJsonModule": true,
    "target": "ES2022",
    "lib": [ "ESNext" ],
    "skipLibCheck": true,
    "strict": true,
  },
  "include": [
    "migrations/**/*.ts",
    "src/**/*.ts"
  ]
}
