{
  "name": "backend-template",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm -r --if-present run check",
    "test": "pnpm -r --workspace-concurrency=1 --filter '!integration-test' --if-present run test && pnpm -C integration-test run check",
    "lint": "pnpm -r --if-present run lint",
    "dev": "npm-run-all --parallel dev:*",
    "dev:firebase-emulator": "cd firebase && pnpm run dev",
    "dev:app-server": "sleep 10 && cd app-server && pnpm run dev",
    "dev:manage": "sleep 10 && cd manage && pnpm run dev",
    "test:integration": "pnpm -C integration-test run test:local",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.34.2",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
